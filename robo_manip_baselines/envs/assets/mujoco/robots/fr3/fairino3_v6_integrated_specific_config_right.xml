<mujoco model="fairino3_v6_integrated_specific_config">
  <actuator>
    <general class="size3" name="right/actuator_j1" joint="right/j1" ctrlrange="-3.0543 3.0543"/>
    <general class="size3" name="right/actuator_j2" joint="right/j2" ctrlrange="-4.6251 1.4835"/>
    <general class="size3_limited" name="right/actuator_j3" joint="right/j3" ctrlrange="-2.8274 2.8274"/>
    <general class="size1" name="right/actuator_j4" joint="right/j4" ctrlrange="-4.6251 1.4835"/>
    <general class="size1" name="right/actuator_j5" joint="right/j5" ctrlrange="-3.0543 3.0543"/>
    <general class="size1" name="right/actuator_j6" joint="right/j6" ctrlrange="-3.0543 3.0543"/>

    <general class="2f85" name="right/fingers_actuator" tendon="right/split"
             forcerange="-5 5" ctrlrange="0 255" gainprm="0.3137255 0 0"
             biasprm="0 -100 -10"/>
  </actuator>

  <sensor>
    <force name="right/force_sensor" site="right/force_sensor"/>
    <torque name="right/torque_sensor" site="right/force_sensor"/>
  </sensor>

  <contact>
    <exclude body1="right/gripper_base" body2="right/left_driver"/>
    <exclude body1="right/gripper_base" body2="right/right_driver"/>
    <exclude body1="right/gripper_base" body2="right/left_spring_link"/>
    <exclude body1="right/gripper_base" body2="right/right_spring_link"/>
    <exclude body1="right/right_coupler" body2="right/right_follower"/>
    <exclude body1="right/left_coupler" body2="right/left_follower"/>
  </contact>

  <tendon>
    <fixed name="right/split">
      <joint joint="right/right_driver_joint" coef="0.5"/>
      <joint joint="right/left_driver_joint" coef="0.5"/>
    </fixed>
  </tendon>

  <equality>
    <connect body1="right/right_follower" body2="right/right_coupler" anchor="0 0 0"
             solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <connect body1="right/left_follower" body2="right/left_coupler" anchor="0 0 0"
             solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <joint joint1="right/right_driver_joint" joint2="right/left_driver_joint"
           polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
  </equality>
</mujoco>
